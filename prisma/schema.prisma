// Prisma schema — persistence layer (an infrastructure detail).
// Client is generated into src/generated/prisma (see .gitignore).
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in prisma.config.ts (for the CLI) and is
  // supplied to PrismaClient at runtime via a driver adapter (see shared/db.ts).
}

// NOTE: this schema targets a SHARED database that already contains another
// project's tables. Every Lab-owned table is namespaced via @@map so it can't
// collide: `calendario` and `usuarioslab` as requested, and `lab_*` for the
// rest. Use `prisma db push` (never `migrate`) so existing tables are untouched.

/// Reusable email template with `{{variable}}` placeholders.
model EmailTemplate {
  id        String   @id @default(uuid())
  name      String
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lab_email_template")
}

/// Google account connected via OAuth to send email as that user via Gmail.
/// Stores the long-lived refresh_token; access tokens are minted on demand.
model GoogleAccount {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String?
  picture      String?
  refreshToken String
  accessToken  String?
  expiresAt    DateTime?
  scope        String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("lab_google_account")
}

/// History of every email send attempt.
model EmailLog {
  id      String   @id @default(uuid())
  to      String
  subject String
  status  String // "sent" | "failed"
  error   String?
  sentAt  DateTime @default(now())

  @@map("lab_email_log")
}

/// A cron-scheduled task that runs an action ("email" | "scrape").
model ScheduledJob {
  id        String   @id @default(uuid())
  name      String
  cron      String // 5-field cron expression
  action    String // "email" | "scrape"
  params    String // JSON payload for the action
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  runs      JobRun[]

  @@map("lab_scheduled_job")
}

/// Result of one execution of a ScheduledJob.
model JobRun {
  id        String       @id @default(uuid())
  jobId     String
  job       ScheduledJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    String // "success" | "error"
  output    String?
  startedAt DateTime     @default(now())

  @@map("lab_job_run")
}

/// Lab users (separate table so it won't collide with the other project's
/// tables in the shared database). Mapped to `usuarioslab`.
model UsuariosLab {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String?
  passwordHash String
  role         String     @default("user") // "user" | "superadmin"
  createdAt    DateTime   @default(now())
  eventos      Calendario[]

  @@map("usuarioslab")
}

/// Calendar events. Mapped to `calendario`.
model Calendario {
  id                  String       @id @default(uuid())
  title               String
  description         String?
  start               DateTime
  end                 DateTime?
  allDay              Boolean      @default(false)
  location            String?
  color               String? // optional accent tag
  /// Minutes before `start` to send a WhatsApp reminder. null = no reminder.
  remindMinutesBefore Int?
  /// Set once the reminder has been sent, to avoid duplicates.
  reminderSentAt      DateTime?
  userId              String?
  user                UsuariosLab? @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([start])
  @@map("calendario")
}

/// Finance module — cuenta bancaria / efectivo / tarjeta / etc.
/// Balances are derived from `initialBalance` + related transactions.
model FinancialAccount {
  id                 String                 @id @default(uuid())
  name               String
  kind               String                 // "cash" | "bank" | "card" | "savings" | "other"
  currency           String                 @default("USD")
  initialBalance     Decimal                @default(0) @db.Decimal(14, 2)
  archived           Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  transactions       FinancialTransaction[]
  recurringPayments  RecurringPayment[]

  @@map("lab_financial_account")
}

/// User-defined category for grouping transactions.
model TransactionCategory {
  id                String                 @id @default(uuid())
  name              String
  kind              String                 // "income" | "expense"
  color             String?
  createdAt         DateTime               @default(now())
  transactions      FinancialTransaction[]
  budgets           Budget[]
  recurringPayments RecurringPayment[]

  @@unique([name, kind])
  @@map("lab_transaction_category")
}

/// A single income / expense against a financial account.
model FinancialTransaction {
  id         String              @id @default(uuid())
  accountId  String
  account    FinancialAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId String?
  category   TransactionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  kind       String              // "income" | "expense"
  amount     Decimal             @db.Decimal(14, 2)
  occurredAt DateTime
  notes      String?
  createdAt  DateTime            @default(now())

  @@index([accountId])
  @@index([occurredAt])
  @@map("lab_financial_transaction")
}

/// Monthly spending limit for an expense category. One budget per category.
model Budget {
  id         String              @id @default(uuid())
  categoryId String              @unique
  category   TransactionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     Decimal             @db.Decimal(14, 2)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@map("lab_budget")
}

/// A recurring payment (rent, subscription…) that auto-creates a transaction
/// on each due date and optionally fires a Telegram reminder beforehand.
model RecurringPayment {
  id            String               @id @default(uuid())
  name          String
  accountId     String
  account       FinancialAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      TransactionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  kind          String               // "income" | "expense"
  amount        Decimal              @db.Decimal(14, 2)
  /// Cadence: "monthly" | "weekly" | "yearly".
  frequency     String               @default("monthly")
  /// The next date this payment is due (also the anchor for the cadence).
  nextRunAt     DateTime
  /// Days before `nextRunAt` to send a Telegram reminder. null = no reminder.
  remindDaysBefore Int?
  /// Set once the reminder for the current `nextRunAt` has been sent.
  reminderSentAt DateTime?
  active        Boolean              @default(true)
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([nextRunAt])
  @@map("lab_recurring_payment")
}

/// Inventory module — a physical place that holds items. Self-referential so
/// places nest (casa → habitación → caja → estante) to any depth.
model InventoryLocation {
  id        String              @id @default(uuid())
  name      String
  kind      String              @default("place") // "room" | "box" | "shelf" | "place"
  parentId  String?
  parent    InventoryLocation?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  InventoryLocation[] @relation("LocationTree")
  items     InventoryItem[]
  notes     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([parentId])
  @@map("lab_inventory_location")
}

/// An item the user owns / manages. `quantity` is the current on-hand count,
/// kept in sync by the movements ledger.
model InventoryItem {
  id          String              @id @default(uuid())
  name        String
  category    String?
  quantity    Int                 @default(0)
  unit        String?             // "u" | "kg" | "l" | …
  locationId  String?
  location    InventoryLocation?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  movements   InventoryMovement[]

  @@index([locationId])
  @@map("lab_inventory_item")
}

/// A single stock movement in the item's history (mini-ERP ledger). `delta`
/// is the signed change applied to the item's quantity.
model InventoryMovement {
  id         String        @id @default(uuid())
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind       String        // "bought" | "sold" | "gave_away" | "received" | "moved" | "adjust"
  delta      Int
  /// For "moved": the destination location; null otherwise.
  toLocationId String?
  notes      String?
  occurredAt DateTime      @default(now())
  createdAt  DateTime      @default(now())

  @@index([itemId])
  @@index([occurredAt])
  @@map("lab_inventory_movement")
}

/// External PostgreSQL databases the DB-admin tool can browse & edit.
/// `connectionUrl` is stored plain (this is a personal lab; only the admin
/// can log in) and is never serialised to the client.
model DbConnection {
  id            String   @id @default(uuid())
  name          String   @unique
  connectionUrl String
  readOnly      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("lab_db_connection")
}

/// GitHub connection for the repos-overview tool. Stores the account username
/// and an optional personal access token (PAT) so private repos and a higher
/// rate limit are available. Token is stored plain (personal lab; only the
/// admin can log in) and is NEVER serialised to the client. Only one active
/// row at a time is expected.
model GitHubConfig {
  id        String   @id @default(uuid())
  username  String
  /// Personal access token. Optional: without it only public repos are shown.
  token     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lab_github_config")
}

/// Notification channel config. Only one active row at a time is expected;
/// the calendar reminder job sends to whichever row has `active = true`.
/// `provider` decides how `recipient` and `credential` are interpreted:
///   - telegram: recipient = chat_id, credential = bot_token
model NotificationConfig {
  id         String   @id @default(uuid())
  provider   String   @default("telegram")
  recipient  String
  credential String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("lab_notification_config")
}
